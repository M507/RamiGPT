# AI provider: openai | openwebui
AI_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY="sk-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
OPENAI_MODEL=gpt-5-mini
# Optional override (leave empty for https://api.openai.com/v1)
OPENAI_BASE_URL=

# --- Open WebUI / Ollama (OpenAI-compatible) ---
# Open WebUI UI host example: http://localhost:3000  (uses /api)
# Ollama native example:      http://10.10.10.6:11434 (uses /v1 automatically)
OPENWEBUI_BASE_URL=http://10.10.10.6:11434
OPENWEBUI_API_KEY=ollama
OPENWEBUI_MODEL=artifish/llama3.2-uncensored:latest

# Shared
OPENAI_MAX_NUM_OF_REQS=20
DEBUG=0

# Local server bind (loopback only by default)
APP_HOST=127.0.0.1
APP_PORT=8443

# Auto-reload on code/template/static changes (default on). Set 0 for Docker/prod.
APP_RELOAD=1
