.env
.venv
venv/
__pycache__/
*.pyc
*.pyo
*.log
*.pem
*.jsonl

# Runtime data — global + per-session logs
data/ai_settings.json
data/logs/**
!data/logs/.gitkeep
!data/logs/sessions/
!data/logs/sessions/.gitkeep
# Keep directory, ignore everything under each session id
data/logs/sessions/**
!data/logs/sessions/.gitkeep

data/sessions/**
!data/sessions/.gitkeep
!data/sessions/hosts/
!data/sessions/hosts/.gitkeep

# Local benchmark lab credentials (never commit)
data/benchmark/remote.json
!data/benchmark/.gitkeep
!data/benchmark/remote.example.json
!data/benchmark/examples/
!data/benchmark/examples/**
!data/benchmark/models/
!data/benchmark/models/**

# Benchmark analysis outputs — per-run sheets + master are collaborative; local ephemeral files ignored
data/benchmark/results/**
!data/benchmark/results/.gitkeep
!data/benchmark/results/master.json
!data/benchmark/results/master_summary.txt
!data/benchmark/results/**/
!data/benchmark/results/**/result.json
!data/benchmark/results/**/summary.txt
!data/benchmark/results/**/batch.json

tools/beroot/Linux/downloaded/*
!tools/beroot/Linux/downloaded/.gitkeep
tools/linenum/downloaded/*
!tools/linenum/downloaded/.gitkeep
tools/linpeas/downloaded/*
!tools/linpeas/downloaded/.gitkeep

# Flask filesystem sessions
data/sessions/flask_session/

# IDE / OS
.idea/
.DS_Store
*.swp

# Tests / coverage
.coverage
.pytest_cache/
htmlcov/

# Local notes
creds.txt
notes.md
doc.md
prompt.md